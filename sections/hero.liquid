{% comment %}
  Purelane Hero — Shopify section
  Recreated from the uploaded purelane-homepage.html.
{% endcomment %}

<style>

:root{--p-kbtl:url("data:image/svg+xml;base64,");--p-tbtl:url("data:image/svg+xml;base64,");--p-mbtl:url("data:image/svg+xml;base64,");}

.purelane-hero-wrap{
  --paper:#ece6f7;--paper-2:rgba(236,230,247,.74);--paper-3:rgba(236,230,247,.52);
  --accent:#f0a03c;--accent-2:#c9761d;--surface:#faf7fd;--ease:cubic-bezier(.2,.7,.2,1);--maxw:1180px;
  position:relative;z-index:2;min-height:100svh;display:block;background:linear-gradient(178deg,#1ea38d 0%,#0b8578 22%,#017069 48%,#4b3a8f 74%,#01524e 100%);
  color:var(--paper);overflow:hidden;font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.62;-webkit-font-smoothing:antialiased;
}
.purelane-hero-wrap *{box-sizing:border-box}
.purelane-hero-wrap a{color:inherit;text-decoration:none}
.purelane-hero-wrap button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.purelane-hero-wrap :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}
.purelane-hero-wrap .d1{font-family:'Outfit',system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.018em;font-weight:800;line-height:.87;color:var(--surface);font-size:clamp(48px,8.6vw,112px)}
.purelane-hero-wrap .lime{color:var(--accent)}
.purelane-hero-wrap .lede{font-size:clamp(15px,1.35vw,17.5px);color:var(--paper-2);max-width:44ch}
.purelane-hero-wrap .rv{opacity:0;transform:translateY(30px);filter:blur(7px);transition:opacity .95s var(--ease),transform .95s var(--ease),filter .95s var(--ease)}
.purelane-hero-wrap .rv.in{opacity:1;transform:none;filter:none}
.purelane-hero-wrap .rv-d1{transition-delay:.09s}.purelane-hero-wrap .rv-d2{transition-delay:.18s}.purelane-hero-wrap .rv-d3{transition-delay:.27s}.purelane-hero-wrap .rv-d4{transition-delay:.36s}
.purelane-hero-wrap .glass-2{background:linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));backdrop-filter:blur(18px) saturate(135%);-webkit-backdrop-filter:blur(18px) saturate(135%);border:1px solid rgba(236,230,247,.16);border-radius:26px;box-shadow:0 18px 48px rgba(18,12,34,.36),inset 0 1px 0 rgba(255,255,255,.16);position:relative;overflow:hidden}
.purelane-hero-wrap .btn{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 22px;border-radius:999px;font-size:12.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;transition:.35s var(--ease);white-space:nowrap}
.purelane-hero-wrap .btn svg{width:15px;height:15px;flex:0 0 auto}
.purelane-hero-wrap .btn-primary{background:linear-gradient(135deg,var(--accent-2),#5d8d1c);color:#08211a;box-shadow:0 12px 30px rgba(201,118,29,.34),inset 0 1px 0 rgba(255,255,255,.34)}
.purelane-hero-wrap .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(201,118,29,.44),inset 0 1px 0 rgba(255,255,255,.4)}
.purelane-hero-wrap .btn-ghost{background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.30);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:var(--surface)}
.purelane-hero-wrap .btn-ghost:hover{background:rgba(236,230,247,.18);transform:translateY(-2px)}

.purelane-hero{position:relative;z-index:2;min-height:100svh;display:flex;align-items:flex-end;padding:150px 0 34px}
.purelane-hero::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(102deg,rgba(1,45,42,.68) 0%,rgba(1,45,42,.40) 30%,rgba(1,45,42,.10) 52%,transparent 66%)}
.purelane-hero-grid{max-width:var(--maxw);margin:0 auto;padding:0 18px;width:100%;position:relative;z-index:2}
.purelane-hero-copy{max-width:600px;position:relative;z-index:3}
.purelane-hero h1{margin-bottom:20px;text-shadow:0 6px 40px rgba(2,20,19,.55)}
.purelane-hero .rule{display:flex;align-items:center;gap:13px;margin:0 0 20px;max-width:270px}
.purelane-hero .rule i{height:1px;flex:1;background:linear-gradient(90deg,rgba(236,230,247,.44),transparent)}
.purelane-hero .rule svg{width:16px;height:16px;color:var(--accent);flex:0 0 auto}
.purelane-hero-cta{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}
.purelane-hero-prod{position:absolute;right:2%;bottom:28px;width:min(50vw,560px);z-index:2;filter:drop-shadow(0 34px 54px rgba(2,20,19,.6))}

.purelane-hero .badges{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:96px;z-index:4;display:flex;flex-direction:column;gap:2px;padding:12px 8px;border-radius:20px}
.purelane-hero .badge{text-align:center;padding:11px 4px}
.purelane-hero .badge+.badge{border-top:1px solid rgba(236,230,247,.14)}
.purelane-hero .badge .bi{width:38px;height:38px;margin:0 auto 8px;border-radius:50%;display:grid;place-items:center;background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.22);color:var(--accent)}
.purelane-hero .badge .bi svg{width:19px;height:19px}
.purelane-hero .badge span{display:block;font-size:8.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--paper-2);line-height:1.34}
.purelane-hero .badgestrip{display:flex;gap:8px;margin-top:24px}
.purelane-hero .badgestrip div{flex:1;text-align:center;padding:11px 6px;border-radius:14px;font-size:8.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-2);line-height:1.3}
.purelane-hero .badgestrip svg{width:18px;height:18px;margin:0 auto 6px;color:var(--accent)}

.purelane-hero .p-kbtl{background-image:var(--p-kbtl);aspect-ratio:.3229}
.purelane-hero .p-tbtl{background-image:var(--p-tbtl);aspect-ratio:.322}
.purelane-hero .p-mbtl{background-image:var(--p-mbtl);aspect-ratio:.3416}
.purelane-hero .hstage{position:relative;width:100%;height:clamp(380px,74svh,680px)}
.purelane-hero .hslide{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:flex-end;padding-right:2%;opacity:0;pointer-events:none;transition:opacity .85s var(--ease)}
.purelane-hero .hslide.on{opacity:1}
.purelane-hero .hp{position:relative;width:auto;flex:0 0 auto;background-repeat:no-repeat;background-position:center bottom;background-size:contain;opacity:0;transform:translateY(28px) scale(.94);transition:opacity .8s var(--ease),transform .8s var(--ease);filter:drop-shadow(0 26px 40px rgba(1,22,20,.66))}
.purelane-hero .hslide.on .hp{opacity:1;transform:none}
.purelane-hero .hslide.on .hp.d1{transition-delay:.06s}
.purelane-hero .hslide.on .hp.d2{transition-delay:.30s}
.purelane-hero .hslide.on .hp.d3{transition-delay:.54s}
.purelane-hero .hs1 .a{height:100%;z-index:3}
.purelane-hero .hs2 .a{height:80%;margin-right:-8%;z-index:1}
.purelane-hero .hs2 .b{height:97%;z-index:3}
.purelane-hero .hs3 .a{height:75%;margin-right:-8%;z-index:1;order:1}
.purelane-hero .hs3 .c{height:97%;z-index:3;order:2}
.purelane-hero .hs3 .b{height:79%;margin-left:-8%;z-index:2;order:3}
.purelane-hero .ptag{position:absolute;left:0;bottom:2%;z-index:6;padding:11px 14px 12px;border-radius:16px;max-width:52%;opacity:0;transform:translateY(16px);transition:opacity .8s var(--ease) .62s,transform .8s var(--ease) .62s}
.purelane-hero .hslide.on .ptag{opacity:1;transform:none}
.purelane-hero .ptag .lbl{display:block;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase;color:var(--accent)}
.purelane-hero .ptag .val{display:flex;align-items:baseline;gap:7px;margin-top:5px}
.purelane-hero .ptag .val strong{font-family:'Outfit',sans-serif;font-size:23px;font-weight:800;letter-spacing:-.02em;color:var(--surface);line-height:1}
.purelane-hero .ptag .val s{font-size:12px;color:var(--paper-3)}
.purelane-hero .ptag .cut{display:inline-block;margin-top:7px;font-size:8.4px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;padding:3px 8px;border-radius:999px;background:rgba(240,160,60,.20);border:1px solid rgba(240,160,60,.38);color:var(--accent)}
.purelane-hero .hdots{display:flex;gap:7px;justify-content:center;align-items:center;margin-top:8px}
.purelane-hero .hdots button{width:6px;height:6px;padding:0;border-radius:50%;background:rgba(236,230,247,.28);transition:.4s var(--ease)}
.purelane-hero .hdots button.on{background:var(--accent);width:20px;border-radius:999px}
.purelane-hero .hdots button:hover{background:rgba(236,230,247,.5)}

@media(max-width:1200px){.purelane-hero-copy{max-width:470px}.purelane-hero-prod{width:min(44vw,440px);right:3%}}
@media(max-width:900px){
  .purelane-hero{align-items:flex-end;padding-top:132px}
  .purelane-hero::before{background:linear-gradient(180deg,rgba(1,45,42,.44) 0%,rgba(1,45,42,.22) 34%,rgba(1,40,38,.60) 100%)}
  .purelane-hero-copy{max-width:none}
  .purelane-hero-prod{position:relative;right:auto;bottom:auto;width:min(88vw,420px);margin:20px auto 0}
  .purelane-hero .badges{display:none}
  .purelane-hero .hstage{height:clamp(300px,44svh,430px)}
  .purelane-hero .ptag{padding:9px 12px 10px;border-radius:14px;max-width:58%}
  .purelane-hero .ptag .val strong{font-size:20px}
}
@media(min-width:901px){.purelane-hero .badgestrip{display:none}}
@media(prefers-reduced-motion:reduce){.purelane-hero-wrap .rv,.purelane-hero-wrap .hp,.purelane-hero-wrap .hslide,.purelane-hero-wrap .ptag{transition:none!important}}

</style>

<div class="purelane-hero-wrap" data-section-id="{{ section.id }}">
<section class="purelane-hero" data-scene="1">
  <div class="purelane-hero-grid">

    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
        <span>Plant<br>powered</span>
      </div>
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg></span>
        <span>Safe for<br>kids &amp; pets</span>
      </div>
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg></span>
        <span>Zero harsh<br>chemicals</span>
      </div>
    </div>

    <div class="purelane-hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading_line_1 | escape }}<br>{{ section.settings.heading_line_2 | escape }}<br><span class="lime">{{ section.settings.heading_line_3 | escape }}</span></h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.description | escape }}</p>
      <div class="hero-cta rv rv-d3">
        <a class="btn btn-primary" href="{{ section.settings.primary_link | default: '#shop' }}">{{ section.settings.primary_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="{{ section.settings.secondary_link | default: '#how' }}">{{ section.settings.secondary_label | escape }}</a>
      </div>

      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          Plant powered
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          Kids &amp; pet safe
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          Zero harsh chem
        </div>
      </div>
    </div>

    <div class="purelane-hero-prod" id="heroProd"><div class="hstage" id="hstage"><div class="hslide hs1 on" data-n="1"><span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span><div class="glass-2 ptag"><span class="lbl">Single bottle</span><span class="val"><strong>&#8377;200</strong><s>&#8377;299</s></span><span class="cut">33% off</span></div></div><div class="hslide hs2" data-n="2"><span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span><span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span><div class="glass-2 ptag"><span class="lbl">Any 2 products</span><span class="val"><strong>&#8377;349</strong><s>&#8377;598</s></span><span class="cut">Save &#8377;249</span></div></div><div class="hslide hs3" data-n="3"><span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span><span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span><span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span><div class="glass-2 ptag"><span class="lbl">Any 3 products</span><span class="val"><strong>&#8377;499</strong><s>&#8377;897</s></span><span class="cut">Save &#8377;398</span></div></div></div><div class="hdots" id="hdots"><button type="button" class="on" aria-label="Show 1 product"></button><button type="button" class="" aria-label="Show 2 products"></button><button type="button" class="" aria-label="Show 3 products"></button></div></div>

  </div>
</section>
</div>

<script>
(function(){
  var root=document.querySelector('[data-section-id="{{ section.id }}"]');
  if(!root) return;
  var reduce=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  root.querySelectorAll('.rv').forEach(function(el){
    if(el.classList.contains('in')) return;
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(entries,obs){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target);}});},{threshold:.12}).observe(el);
    }else{el.classList.add('in');}
  });
  var hstage=root.querySelector('#hstage');
  if(hstage){
    var hs=[].slice.call(hstage.querySelectorAll('.hslide'));
    var hd=[].slice.call(root.querySelectorAll('#hdots button'));
    var hi=0,htimer=null;
    function hgo(n){hi=(n+hs.length)%hs.length;hs.forEach(function(s,i){s.classList.toggle('on',i===hi);});hd.forEach(function(d,i){d.classList.toggle('on',i===hi);});}
    function hplay(){if(!htimer&&!reduce)htimer=setInterval(function(){hgo(hi+1);},3800);}
    function hstop(){if(htimer){clearInterval(htimer);htimer=null;}}
    hd.forEach(function(d,i){d.addEventListener('click',function(){hstop();hgo(i);hplay();});});
    hstage.addEventListener('mouseenter',hstop);hstage.addEventListener('mouseleave',hplay);
    if('IntersectionObserver' in window){new IntersectionObserver(function(es){es.forEach(function(e){e.isIntersecting?hplay():hstop();});},{threshold:.2}).observe(hstage);}else{hplay();}
  }
})();
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "section-purelane-hero",
  "settings": [
    {"type":"text","id":"heading_line_1","label":"Heading line 1","default":"Clean"},
    {"type":"text","id":"heading_line_2","label":"Heading line 2","default":"That"},
    {"type":"text","id":"heading_line_3","label":"Heading line 3","default":"Lasts"},
    {"type":"textarea","id":"description","label":"Description","default":"Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Shop now"},
    {"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"How it works"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"}
  ],
  "presets": [{"name":"Purelane Hero"}]
}
{% endschema %}
